{
  "name": "@agentix/charts",
  "version": "0.1.0-beta.0",
  "description": "Accessible, theme-aware React charts for Agentix applications",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./quant": {
      "types": "./dist/quant.d.ts",
      "import": "./dist/quant.js",
      "require": "./dist/quant.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "aapaetsch-ui-kit": ">=0.2.0-beta.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
