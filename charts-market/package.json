{
  "name": "@agentix/charts-market",
  "version": "0.1.0-beta.0",
  "description": "Modular, accessible technical-market charts for Agentix applications",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./indicators": { "types": "./dist/indicators.d.ts", "import": "./dist/indicators.js" },
    "./drawings": { "types": "./dist/drawings.d.ts", "import": "./dist/drawings.js" },
    "./overlays": { "types": "./dist/overlays.d.ts", "import": "./dist/overlays.js" },
    "./controls": { "types": "./dist/controls.d.ts", "import": "./dist/controls.js" },
    "./workspace": { "types": "./dist/workspace.d.ts", "import": "./dist/workspace.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "aapaetsch-ui-kit": ">=0.2.0-beta.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
