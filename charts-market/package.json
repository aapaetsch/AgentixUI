{
  "name": "aapaetsch-charts-market",
  "version": "0.1.0-beta.2",
  "description": "Modular, accessible technical-market charts for Agentix applications",
  "author": "Aidan Paetsch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aapaetsch/AgentixUI.git",
    "directory": "charts-market"
  },
  "bugs": {
    "url": "https://github.com/aapaetsch/AgentixUI/issues"
  },
  "homepage": "https://github.com/aapaetsch/AgentixUI/tree/main/charts-market#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true,
    "tag": "beta"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SUPPLIED-RESULTS.md",
    "CALENDAR-COORDINATES.md",
    "REFINEMENT.md",
    "READABILITY.md",
    "ADAPTIVE-WIDTHS.md",
    "MOVING-AVERAGE-LABELS.md",
    "ENDPOINT-LABELS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./indicators": {
      "types": "./dist/indicators.d.ts",
      "import": "./dist/indicators.js",
      "require": "./dist/indicators.cjs"
    },
    "./drawings": {
      "types": "./dist/drawings.d.ts",
      "import": "./dist/drawings.js",
      "require": "./dist/drawings.cjs"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js",
      "require": "./dist/overlays.cjs"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js",
      "require": "./dist/controls.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "aapaetsch-ui-kit": ">=0.2.0-beta.3",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "aapaetsch-ui-kit": "file:..",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "main": "./dist/index.cjs",
  "dependencies": {
    "aapaetsch-icons": "0.1.0-beta.0"
  }
}
